{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modbus Remote Bench",
  "mainBinaryName": "modbus-remote-bench",
  "version": "2.5.0",
  "identifier": "cn.modbus.remote-debug",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Modbus 远程调试台（Modbus Remote Bench）",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' wss: ws:; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SYCC",
    "copyright": "Copyright SYCC",
    "windows": {
      "wix": {
        "language": ["en-US", "zh-CN"]
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "depends": [
          "libayatana-appindicator3-1",
          "libssl3",
          "libxdo3"
        ]
      }
    },
    "shortDescription": "Modbus RS485 remote debugging desktop client",
    "longDescription": "Desktop remote client for the ESP32 BLE-RS485 gateway. Joins a 7-character assist session over MQTT and works the RS485 bus remotely.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
